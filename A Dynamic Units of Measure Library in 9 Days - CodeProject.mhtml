    public readonly MeasureUnit Unit;

    public Quantity( double v, MeasureUnit u )
    {
        Value =3D v;
        Unit =3D u;
    }


    public Quantity Multiply( Quantity q ) =3D&gt; new Quantity( Value * q.=
Value, Unit * q.Unit );

    public Quantity DivideBy( Quantity q ) =3D&gt; new Quantity( Value / q.=
Value, Unit / q.Unit );

    public Quantity Invert() =3D&gt; new Quantity( 1.0 / Value, Unit.Invert=
() );

    public Quantity Power( int exp ) =3D&gt;=20
               new Quantity( Math.Pow( Value, exp ), Unit.Power( exp ) );

    public bool CanConvertTo( MeasureUnit u ) =3D&gt; Unit.Normalization =
=3D=3D u.Normalization;


    public Quantity ConvertTo( MeasureUnit u )
    {
